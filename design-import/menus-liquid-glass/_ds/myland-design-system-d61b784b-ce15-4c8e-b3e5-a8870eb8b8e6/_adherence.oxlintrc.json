{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/glass/**",
              "ui_kits/editor/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Geist|Geist Mono|Instrument Serif|DM Sans|Space Mono|Newsreader|Playfair Display|Bebas Neue|Syne|Archivo|Pacifico|Great Vibes))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Geist, Geist Mono, Instrument Serif, DM Sans, Space Mono, Newsreader, Playfair Display, Bebas Neue, Syne, Archivo, Pacifico, Great Vibes."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorPopover'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onClose|alpha|swatches|label|style|key|ref|className|style|children)$/]",
        "message": "<ColorPopover> doesn't accept that prop. Declared props: value, onChange, onClose, alpha, swatches, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContextMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|keys|tone|disabled|onSelect|key|ref|className|style|children)$/]",
        "message": "<ContextMenuItem> doesn't accept that prop. Declared props: icon, label, keys, tone, disabled, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContextMenuItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:danger)$/]",
        "message": "<ContextMenuItem> tone must be one of 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FontOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|family|category|key|ref|className|style|children)$/]",
        "message": "<FontOption> doesn't accept that prop. Declared props: key, label, family, category."
      },
      {
        "selector": "JSXOpeningElement[name.name='FontOption'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:sans|serif|display|mono|script|custom)$/]",
        "message": "<FontOption> category must be one of 'sans' | 'serif' | 'display' | 'mono' | 'script' | 'custom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|className|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style, title."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
